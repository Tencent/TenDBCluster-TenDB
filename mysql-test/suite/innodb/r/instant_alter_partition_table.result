1	1
1001	1
2001	1
alter table t1 add column (
`d1` int(11) DEFAULT NULL,
`d2` int(11) NOT NULL DEFAULT 10,
`d3` varchar(20) NOT NULL DEFAULT 'abcde',
`d4` timestamp NOT NULL DEFAULT current_timestamp());
