create database instant_alter;
use instant_alter;
set timestamp = 1;
set time_zone='+03:00';
CREATE TABLE `t1` ( `id` int(11) NOT NULL, `c2` int(11) DEFAULT NULL, PRIMARY KEY (`id`)) ENGINE=InnoDB ROW_FORMAT=redundant
PARTITION BY RANGE (`id`)
(PARTITION p1 VALUES LESS THAN (1000),
PARTITION p2 VALUES LESS THAN (2000),
PARTITION p3 VALUES LESS THAN MAXVALUE);
insert into t1(id, c2) values(1,1);
insert into t1(id, c2) values(1001,1);
insert into t1(id, c2) values(2001,1);
select * from t1;
