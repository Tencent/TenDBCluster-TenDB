SET  binlog_row_image=full;
# BINLOG_FORMAT = ROW
# BINLOG_ROW_IMAGE = FULL
#
# Preparatory cleanup.
#
DROP TABLE IF EXISTS t1;
DROP TABLE IF EXISTS t2;
#
# We need a fixed timestamp to avoid varying results.
#
SET timestamp=1000000000;
set global log_bin_compress = OFF;
CREATE TABLE t1 (
c01 bigint unsigned primary key,
c02 tinyint,
c03 smallint,
c04 mediumint unsigned,
c05 int,
c06 bigint,
c07 char(10),
c08 varchar(20),
c09 varbinary(20),
c10 datetime,
c11 timestamp(3),
c12 float,
c13 decimal(10,3),
c14 TEXT,
c15 BLOB,
c16 JSON
) ENGINE=InnoDB;
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c01` bigint(20) unsigned NOT NULL,
  `c02` tinyint(4) DEFAULT NULL,
  `c03` smallint(6) DEFAULT NULL,
  `c04` mediumint(8) unsigned DEFAULT NULL,
  `c05` int(11) DEFAULT NULL,
  `c06` bigint(20) DEFAULT NULL,
  `c07` char(10) DEFAULT NULL,
  `c08` varchar(20) DEFAULT NULL,
  `c09` varbinary(20) DEFAULT NULL,
  `c10` datetime DEFAULT NULL,
  `c11` timestamp(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3),
  `c12` float DEFAULT NULL,
  `c13` decimal(10,3) DEFAULT NULL,
  `c14` text,
  `c15` blob,
  `c16` json DEFAULT NULL,
  PRIMARY KEY (`c01`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1
